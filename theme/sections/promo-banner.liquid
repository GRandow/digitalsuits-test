{%- comment -%}
  Promo banner

  Full-width banner with a background image (or color) and a content card.
  The card can be placed left / center / right and top / middle / bottom,
  and shows an optional product image, a heading and rich text.
{%- endcomment -%}

{{ 'section-promo-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.button_mode == 'add_to_cart' -%}
  <script src="{{ 'promo-banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign featured_product = section.settings.product
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}

  #PromoBanner-{{ section.id }} {
    --promo-banner-min-height: {{ section.settings.min_height }}px;
    --promo-banner-background: {{ section.settings.background_color }};
    --promo-banner-card-width: {{ section.settings.card_width }}%;
    --promo-banner-card-height: {{ section.settings.card_height | divided_by: 100.0 }};
    --promo-banner-card-background: {{ section.settings.card_background }};
    --promo-banner-heading-color: {{ section.settings.heading_color }};
    --promo-banner-text-color: {{ section.settings.text_color }};
    --promo-banner-text-size: {{ section.settings.text_size }}px;
    --promo-banner-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --promo-banner-heading-weight: {{ heading_font.weight }};
    --promo-banner-heading-style: {{ heading_font.style }};
    --promo-banner-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --promo-banner-body-weight: {{ body_font.weight }};
    --promo-banner-body-style: {{ body_font.style }};
    --promo-banner-accent-color: {{ section.settings.button_color }};
    --promo-banner-button-text-color: {{ section.settings.button_text_color }};
  }
{%- endstyle -%}

<section
  id="PromoBanner-{{ section.id }}"
  class="promo-banner promo-banner--x-{{ section.settings.content_position }} promo-banner--y-{{ section.settings.vertical_position }} promo-banner--mobile-{{ section.settings.mobile_layout }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="PromoBannerHeading-{{ section.id }}"
  {% endif %}
>
  {%- if section.settings.background_image != blank -%}
    <div class="promo-banner__media">
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag:
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          sizes: '100vw',
          class: 'promo-banner__image',
          loading: image_loading,
          fetchpriority: image_fetchpriority
      }}
    </div>
  {%- endif -%}

  <div class="promo-banner__inner">
    <div class="promo-banner__card promo-banner__card--{{ section.settings.text_alignment }}">
      {%- if section.settings.show_product_image and featured_product.featured_image != blank -%}
        {%- assign product_image_alt = featured_product.featured_image.alt | default: featured_product.title -%}
        <div class="promo-banner__product-media{% if section.settings.blend_product_image %} promo-banner__product-media--blend{% endif %}">
          {{
            featured_product.featured_image
            | image_url: width: 800
            | image_tag:
              widths: '200, 300, 400, 600, 800',
              sizes: '(min-width: 750px) 320px, 50vw',
              class: 'promo-banner__product-image',
              alt: product_image_alt,
              loading: 'lazy'
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2
          id="PromoBannerHeading-{{ section.id }}"
          class="promo-banner__heading promo-banner__heading--{{ section.settings.heading_size }}"
        >
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="promo-banner__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- liquid
        assign button_classes = 'promo-banner__button promo-banner__button--' | append: section.settings.button_style
      -%}

      {%- case section.settings.button_mode -%}
        {%- when 'link' -%}
          {%- comment -%}
            A link without a URL is only rendered in the theme editor, so the merchant can see and style it.
          {%- endcomment -%}
          {%- if section.settings.button_label != blank -%}
            {%- if section.settings.button_link != blank -%}
              <div class="promo-banner__action">
                <a href="{{ section.settings.button_link }}" class="{{ button_classes }}">
                  {{- section.settings.button_label | escape -}}
                </a>
              </div>
            {%- elsif request.design_mode -%}
              <div class="promo-banner__action">
                <a role="link" aria-disabled="true" class="{{ button_classes }}">
                  {{- section.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          {%- endif -%}

        {%- when 'add_to_cart' -%}
          {%- liquid
            assign variant = featured_product.selected_or_first_available_variant
            assign form_id = 'PromoBannerForm-' | append: section.id
            assign cart_button_label = section.settings.cart_button_label
            if cart_button_label == blank
              assign cart_button_label = 'products.product.add_to_cart' | t
            endif
          -%}
          {%- if featured_product != blank -%}
            <div class="promo-banner__action">
              <promo-banner-cart-form
                data-error-message="{{ 'sections.cart.cart_error' | t | escape }}"
                data-loading-message="{{ 'accessibility.loading' | t | escape }}"
              >
                {%- form 'product', featured_product, id: form_id, class: 'promo-banner__form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button
                    type="submit"
                    name="add"
                    class="{{ button_classes }}"
                    aria-describedby="PromoBannerProductTitle-{{ section.id }}"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span class="promo-banner__button-label">
                      {%- if variant.available -%}
                        {{- cart_button_label | escape -}}
                      {%- else -%}
                        {{- 'products.product.sold_out' | t -}}
                      {%- endif -%}
                    </span>
                    <span class="promo-banner__spinner" aria-hidden="true"></span>
                  </button>
                  <span id="PromoBannerProductTitle-{{ section.id }}" class="promo-banner__visually-hidden">
                    {{- featured_product.title | escape -}}
                  </span>
                  <span class="promo-banner__visually-hidden" role="status" data-promo-banner-status></span>
                  <p class="promo-banner__error" role="alert" data-promo-banner-error></p>
                {%- endform -%}
              </promo-banner-cart-form>
            </div>
          {%- elsif request.design_mode -%}
            {%- comment -%} Placeholder for the merchant until a product is selected; buyers see no button. {%- endcomment -%}
            <div class="promo-banner__action">
              <button type="button" class="{{ button_classes }}" disabled>
                {{- 'products.product.unavailable' | t -}}
              </button>
            </div>
          {%- endif -%}
      {%- endcase -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Landscape image, at least 2000 px wide."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Visible when no image is selected.",
      "default": "#F6F6F6"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 360,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 880
    },
    {
      "type": "header",
      "content": "Card position"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "info": "Visible when the card height is below 100%.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 44
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "info": "Relative to the banner height.",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stack", "label": "Card below image" },
        { "value": "overlay", "label": "Card over image" }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#E4E0DD"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5E5E5E"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shown in the card and used by the \"Add product to cart\" button. Leave empty for a text-only card."
    },
    {
      "type": "checkbox",
      "id": "show_product_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blend_product_image",
      "label": "Blend product image with card background",
      "info": "Makes white product photo backgrounds take the card color.",
      "default": true
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover The Capri"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The quest for the perfect sneaker ends right here, with the Capri. It's your day-to-night go to. Keep them box-fresh or let them get scuffed up—you'll love them either way.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text and button size",
      "info": "Scaled down on mobile.",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "cormorant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "arial_n4"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "button_mode",
      "label": "Button behavior",
      "options": [
        { "value": "none", "label": "Hidden" },
        { "value": "link", "label": "Link to a page" },
        { "value": "add_to_cart", "label": "Add product to cart" }
      ],
      "default": "link"
    },
    {
      "type": "paragraph",
      "content": "\"Add product to cart\" uses the product selected in the Card settings and adds its first available variant.",
      "visible_if": "{{ section.settings.button_mode == 'add_to_cart' }}"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop Men",
      "visible_if": "{{ section.settings.button_mode == 'link' }}"
    },
    {
      "type": "text",
      "id": "cart_button_label",
      "label": "Add to cart label",
      "info": "Leave empty to show \"Add to cart\".",
      "visible_if": "{{ section.settings.button_mode == 'add_to_cart' }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all",
      "visible_if": "{{ section.settings.button_mode == 'link' }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "link", "label": "Underlined link" },
        { "value": "solid", "label": "Solid button" }
      ],
      "default": "link",
      "visible_if": "{{ section.settings.button_mode != 'none' }}"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#841719",
      "visible_if": "{{ section.settings.button_mode != 'none' }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.button_mode != 'none' and section.settings.button_style == 'solid' }}"
    }
  ],
  "presets": [
    {
      "name": "Promo banner"
    }
  ]
}
{% endschema %}
